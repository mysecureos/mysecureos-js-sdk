{
  "name": "mysecureos-js-sdk",
  "version": "0.2.3",
  "description": "Trigger and track MySecureOS emergency activations using a trusted-partner API key.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mysecureos/mysecureos-js-sdk.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "version": "biome format --write package.json && git add package.json",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "react": "^19.2.3",
    "react-native": "^0.86.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
